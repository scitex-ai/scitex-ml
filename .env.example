# scitex-ml environment variables
#
# Copy this file to `.env` (gitignored) and edit values for your setup.
# CLI flags always override env vars when both are given. Variables
# follow the SciTeX ecosystem convention: SCITEX_<MODULE>_<NAME>.
#
# Local state (per the SciTeX local-state convention) is read from:
#   ~/.scitex/ml/               user-global config + cache
#   <proj-root>/.scitex/ml/     project-local overrides (preferred)

# Click shell-completion trigger consumed transiently by
# `scitex-ml completion install` while rendering the drop-in script.
# Never set this by hand; shown here only so the variable is documented.
# _SCITEX_ML_COMPLETE=bash_source
